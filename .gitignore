# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets — never commit
.env

# Personal profile override — local-only (the repo is public). The real "Mohith
# profile" lives here or in the OH_PROFILE_JSON secret; only the .example is tracked.
profile.local.json

# Logs (regenerated each run; not worth versioning)
logs/*.log

# TaskFlow's own local data/log (not part of this project)
.taskflow/

# NOTE: data/*.json is intentionally NOT ignored — the cloud workflow commits
# seen_items.json / history.json back so dedup survives across daily runs.
# Exception: dumped.json + tracker.json + taste.json are LOCAL state (taps happen
# locally only).
data/dumped.json
data/tracker.json
data/taste.json
# Career profile — the unified single-source-of-truth; holds personal data (work
# history, email), derived from your GitHub/certs/LinkedIn. Local-only, never public.
data/career_profile.json

# Project brain — local-only, never public
CLAUDE.md

# Personal marketing drafts — never public
linkedin post/

# Gmail OAuth secrets (Inbox Scout) — never commit
credentials.json
token.json

# Inbox Scout opportunities (from your email) — personal, local only
data/inbox_items.json

# Inbox Assistant outputs (your real email) — personal, local only
data/inbox_summary.json
inbox_dashboard.html
data/inbox_tasks_done.json
inbox_secret.txt

# Google OAuth client secrets — the download keeps its long generated filename,
# so match the prefix rather than one exact name (a *_new.txt variant slipped past once).
client_secret*.json
inbox_secret*.txt

# Your standing hunt target — personal goal, money floor, why you need it. Public repo:
# the example template is committed, your real copy is not.
hunt_target.json

# Application packs — tailored resumes and the jobs you are going after. Yours, not GitHub's.
applications/
